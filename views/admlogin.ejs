<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login E kart</title>
    <link rel="stylesheet" href="./css/bootstrap.css">
</head>
<body>
    
    <h1> Admin Login</h1>
    <div class="container">
        <%
        if(msg != undefined){ %>
            <div class="alert alert-<%=type%>"> <%= msg%></div>
        <% } %>
    <form action="/admin/admlogin" method="post" class="row g-3 needs-validation" novalidate>
  <div class="col-md-4">
    <label for="validationCustom01" class="form-label">Admin ID</label>
    <input type="text" class="form-control" name="adminid" id="validationCustom01">
    <div class="valid-feedback">Looks good!</div>
    <div class="invalid-feedback">Username Required!</div>
  </div>
  <div class="col-md-4">
    <label for="validationCustom02" class="form-label">Admin Password</label>
    <input type="password" class="form-control" name="adminpass" id="validationCustom02">
    <div class="valid-feedback"> Looks good! </div>
    <div class="invalid-feedback"> Password Required! </div>
  </div>
  <div class="col-md-12">
    <button class="btn btn-warning"> Admin Login </button>
  </div>
  </form>
    </div>

</body>
</html>