<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
 <%- include('components/header')%>
<h1> Forget Password</h1>
<% if(msg != undefined) { %>
   <div class="alert alert-<%=type%>" role="alert"> <%= msg %></div>  
<% }%>
<div class="container">
   <form class="px-4 py-3" action="/forgetpass" method="post">
    <div class="mb-3">
      <label for="exampleDropdownFormEmail1" class="form-label">Email address</label>
      <input type="email" name="email" class="form-control" id="exampleDropdownFormEmail1" placeholder="email@example.com">
    </div>
    <button type="submit" class="btn btn-primary">Send OTP</button>
  </form>
</div>
  <%- include('components/footer')%>    
</body>
</html>