<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
<%- include('components/header')%>
<h2>Account Verification Page</h2>

<div class="gapping"></div>
<%if(msg != undefined){ %>
    <div class="alert alert-<%=type%>" role="alert"> <%= msg %></div>
<% } %>
  <form class="px-4 py-3" action="/verifyaccount" method="post">
    <div class="mb-3">
      <input type="hidden" name="email" value="<%=useremail %>" class="form-control" id="exampleDropdownFormEmail1" >
    </div>
    <div class="mb-3">
      <label for="exampleDropdownFormPassword1" class="form-label">OTP</label>
      <input type="password" name="otp" class="form-control" id="exampleDropdownFormPassword1" name="otp">
    </div>
    <button type="submit" class="btn btn-primary">Verify Now !</button>
  </form>
  <div class="dropdown-divider"></div>
  <a class="dropdown-item" href="/resend OTP">Resend OTP</a>

<div class="gapping"></div>




  <%- include('components/footer')%>

</body>
</html>