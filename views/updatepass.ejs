<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
     <%- include('components/header')%>
<h1> Update New Password</h1>
<div class="container">
   <form class="px-4 py-3" action="/updatepass" method="post">
    <div class="mb-3">
      <input type="hidden" name="email" value="<%= useremail%>">
    </div>
    <div class="mb-3">
      <label for="exampleDropdownFormEmail1" class="form-label">Password</label>
      <input type="password" name="newpassword" required class="form-control" id="exampleDropdownFormEmail1" placeholder="email@example.com">
    </div>
    <div class="mb-3">
      <label for="exampleDropdownFormEmail1" class="form-label">Password</label>
      <input type="text" name="cnfpassword" required     class="form-control" id="exampleDropdownFormEmail1" placeholder="email@example.com">
    </div>
    <button type="submit" class="btn btn-primary">Update Now !</button>
  </form>
</div>

  <%- include('components/footer')%>    

</body>
</html>